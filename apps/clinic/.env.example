# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Configure these only when a SigNoz/OpenTelemetry collector exists.
OTEL_SERVICE_NAME=clinic
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Supabase (hosted or local). Copy to .env.local — never commit secrets.
# Auth emails (signup, magic link, reset) go through Resend as custom SMTP in
# the Supabase dashboard (Authentication → SMTP), not this file. After SMTP is
# on, raise Authentication → Rate Limits → emails sent (built-in is 2/hour).
# Paste branded HTML from supabase/templates/ into Authentication → Email
# Templates. Set Authentication → URL Configuration → Site URL to this
# clinic origin (no trailing slash) so {{ .SiteURL }} is correct. Set SITE_URL
# to the same origin — invite magic links use it, not the request Host.
# Authentication → Providers → Email: minimum password length 12, leaked
# password protection on — must match passwordSchema (not GoTrue's default 6).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SITE_URL=http://localhost:3000
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
# HMAC secret for shared public-booking rate-limit keys. Required in production.
BOOKING_RATE_LIMIT_SECRET=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_TOKEN_KEY=
# Cloudflare Turnstile (public booking). Secret is server-only. Site key is public.
# Local yarn dev can omit both. Production fails closed when the secret is unset.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Local and Playwright fake-data access only. In next dev, expired clinics receive
# a renewable 30-day manual entitlement. Production runtime ignores this switch.
KARON_TEST_ACCESS_ENABLED=false

# Dentist-to-Karon billing. Checkout is fail-closed until every server-only
# value is configured and the explicit switch is enabled. Prices use centavos;
# no production price is committed while docs/pricing.md remains draft.
BILLING_PUBLIC_CHECKOUT_ENABLED=false
BILLING_PROVIDER=paymongo
BILLING_SKU_NAME=
BILLING_MONTHLY_PRICE_MINOR=
BILLING_YEARLY_PRICE_MINOR=
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_PAYMENT_METHODS=
