# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Configure these only when a SigNoz/OpenTelemetry collector exists.
OTEL_SERVICE_NAME=clinic
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Supabase (hosted or local). Copy to .env.local — never commit secrets.
# Auth emails (signup, magic link, reset) go through Resend as custom SMTP in
# the Supabase dashboard (Authentication → SMTP), not this file. After SMTP is
# on, raise Authentication → Rate Limits → emails sent (built-in is 2/hour).
# Paste branded HTML from supabase/templates/ into Authentication → Email
# Templates. Set Authentication → URL Configuration → Site URL to this
# clinic origin (no trailing slash) so {{ .SiteURL }} is correct. Set SITE_URL
# to the same origin — invite magic links use it, not the request Host.
# Authentication → Providers → Email: minimum password length 12, leaked
# password protection on — must match passwordSchema (not GoTrue's default 6).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SITE_URL=http://localhost:3000
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_TOKEN_KEY=
# Cloudflare Turnstile (public booking). Secret is server-only. Site key is public.
# Local yarn dev can omit both — Siteverify is skipped when the secret is unset.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=