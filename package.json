{
  "name": "karon",
  "private": true,
  "packageManager": "yarn@4.18.0+sha512.fcb8716fe7cd0eece141ffc18b92193a9df9204c1ba83189c288835223fc0bbe64af473bab0d5e9927a7daeb5caf2bb07eb2787cc9338ca040ea125f2a1f2f7e",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint lint:root",
    "lint:root": "eslint e2e playwright.config.ts vitest.config.mts vitest.setup.ts",
    "typecheck": "turbo run typecheck typecheck:root",
    "typecheck:root": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ci": "yarn build && playwright test",
    "db:generate": "yarn workspace @karon/db db:generate",
    "db:migrate": "yarn workspace @karon/db db:migrate",
    "test:rls": "vitest run --config vitest.rls.config.mts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "24",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "9",
    "eslint-config-next": "^16.3.4",
    "jsdom": "^30.0.1",
    "otpauth": "^9.5.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "supabase": "^2.117.0",
    "turbo": "^2.10.12",
    "typescript": "5",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
